---
import Application from '../layouts/Application.astro';
import PageHeading from '../components/PageHeading.astro';
import Prose from '../components/Prose.astro';
import TrackView from '../components/TrackView.astro';
---

<Application title="404" description="The thing you're looking for doesn't exist (404)." noindex>
	<PageHeading>404</PageHeading>

	<Prose>
		<p>The thing you're looking for doesn't exist.</p>
		<p>
			<a href="/">Go back</a>
		</p>
	</Prose>
</Application>

<TrackView key="not-found" />
