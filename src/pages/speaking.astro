---
import { Image } from 'astro:assets';

import Application from '../layouts/Application.astro';
import Spacer from '../components/Spacer.astro';
import PageHeading from '../components/PageHeading.astro';
import Section from '../components/Section.astro';
import Prose from '../components/Prose.astro';
import TrackView from '../components/TrackView.astro';
import Directory from '../components/Directory.astro';
import Stats from '../components/Stats.astro';
import Callout from '../components/Callout.astro';
import PressKit from '../components/PressKit.astro';
import { formatMonth } from '../utils/format';
import { PAGES } from '../consts';

import stageshot from '../assets/images/stageshot.jpg';

function decodeEntities(text: string) {
	return text
		.replace(/&amp;/g, '&')
		.replace(/&lt;/g, '<')
		.replace(/&gt;/g, '>')
		.replace(/&quot;/g, '"')
		.replace(/&#39;/g, "'");
}

async function getLatestEpisode() {
	try {
		const response = await fetch('https://feeds.fireside.fm/off-script/rss');

		if (!response.ok) return null;

		const xml = await response.text();
		const item = xml.match(/<item>([\s\S]*?)<\/item>/)?.[1] ?? '';
		const title = item.match(/<title>([\s\S]*?)<\/title>/)?.[1] ?? '';
		const link = item.match(/<link>([\s\S]*?)<\/link>/)?.[1] ?? '';
		const pubDate = item.match(/<pubDate>([\s\S]*?)<\/pubDate>/)?.[1];
		const episodeId = title.match(/^Episode (\d+):/)?.[1];

		if (!title || !link) return null;

		return {
			name: decodeEntities(title.replace(/^Episode (\d+): /, '#$1: ')),
			href: episodeId ? `https://heypresents.com/podcast/${episodeId}` : link,
			meta: pubDate ? formatMonth(new Date(pubDate)) : '',
		};
	} catch {
		return null;
	}
}

const latestEpisode = await getLatestEpisode();

const bios = [
	{
		label: 'One-liner',
		text: 'Josh Nesbitt is a CTO, conference founder and podcast host based in Leeds, UK.',
	},
	{
		label: 'Short bio',
		text: "Josh Nesbitt is a CTO based in Leeds with over a decade leading engineering in product-led businesses. He founded All Day Hey!, one of the UK's longest-running independent technology conferences, and hosts Off Script, a podcast on engineering leadership and AI.",
	},
];

const stats = [
	{ value: '30+', label: 'engagements since 2013' },
	{ value: '20', label: 'years working on the web' },
	{ value: '10', label: 'editions of All Day Hey! hosted' },
	{ value: '60+', label: 'episodes of Off Script' },
];

const hosting = [
	{
		name: 'All Day Hey! — founder and host, ten editions',
		href: 'https://heypresents.com/conference',
		meta: '2017–2026',
	},
	{ name: 'Off Script — co-host, with James Hall', href: 'https://heypresents.com/podcast', meta: '2019–present' },
	{
		name: 'The reality of AI in software engineering leadership',
		href: 'https://www.linkedin.com/events/softwareengineeringleadership-w7366370929024581633/',
		meta: '2025',
	},
	{ name: 'Empathy at work with Sharon Steed', href: 'https://heypresents.com/talks/empathy-at-work', meta: '2020' },
	{
		name: 'An evening with Helen Sharman, Britain’s first astronaut',
		href: '/thoughts/hosting-a-talk-by-helen-sharman-the-first-british-astronaut',
		meta: '2019',
	},
];

const talks = [
	{
		name: 'No more excuses: the real power of culture and getting things done',
		href: 'https://www.youtube.com/playlist?list=PLJwhw5AkkoduXbcmEpd47h3WDBLHkY4Cj',
		meta: '2024',
	},
	{
		name: 'Another Idea: How creativity can be found anywhere',
		href: 'https://www.youtube.com/watch?v=ZiGwbdJQjls',
		meta: '2022',
	},
	{
		name: 'The Official CIO Summit: IT confronts climate change',
		href: 'https://www.cio.com/article/191630/it-confronts-climate-change.html',
		meta: '2021',
	},
];
---

<Application {...PAGES.speaking}>
	<PageHeading>Speaking</PageHeading>

	<div class="c-hero">
		<Prose class="c-lede">
			<p>
				I speak, host and moderate at technology events — on engineering leadership, AI and building communities. If
				that sounds like a fit for your event, <a href="mailto:speaking@joshnesbitt.dev">get in touch</a>.
			</p>
		</Prose>

		<Image
			class="c-hero__image"
			src={stageshot}
			alt="Josh Nesbitt on stage hosting All Day Hey!, beneath a slide reading 'A conference is a physical network of incredible people'"
			width={976}
			densities={[1, 2]}
		/>
	</div>

	<Spacer />

	<Stats items={stats} />

	<Section title="Topics">
		<Prose>
			<ul>
				<li>
					<strong>Engineering leadership</strong> — building and leading high-performing product engineering teams, from
					startups to scale.
				</li>
				<li>
					<strong>AI in software engineering</strong> — the reality of adoption, the discourse surrounding it, and what
					it means for how teams work.
				</li>
				<li>
					<strong>Conferences and community</strong> — lessons from founding and running All Day Hey! for ten editions.
				</li>
				<li>
					<strong>Hosting and moderation</strong> — MCing conferences, chairing panels and interviewing, honed across
					Off Script and live events.
				</li>
			</ul>
		</Prose>
	</Section>

	<Section title="Hosting">
		<Directory items={hosting} />
	</Section>

	{latestEpisode && (
		<Fragment>
			<Spacer />

			<Callout
				href={latestEpisode.href}
				eyebrow="Latest Off Script episode"
				title={latestEpisode.name}
				meta={`${latestEpisode.meta} · Listen on heypresents.com`}
			/>
		</Fragment>
	)}

	<Section title="Talks and panels">
		<Directory items={talks} />
	</Section>

	<Section title="Press kit">
		<PressKit bios={bios} />
	</Section>
</Application>

<TrackView key="speaking" />
