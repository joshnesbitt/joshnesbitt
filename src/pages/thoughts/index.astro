---
import { getThoughts } from '../../utils/finders';

import Application from '../../layouts/Application.astro';
import PageHeading from '../../components/PageHeading.astro';
import TrackView from '../../components/TrackView.astro';
import PostCards from '../../components/PostCards.astro';

const thoughts = await getThoughts();
---

<Application title="Thoughts" description="A running log of thoughts on engineering, leadership, AI, running conferences and building teams, products, platforms and communities.">
	<PageHeading>Thoughts</PageHeading>

	<PostCards posts={thoughts} path="thoughts" level={2} />
</Application>

<TrackView namespace="thoughts" key="index" />
