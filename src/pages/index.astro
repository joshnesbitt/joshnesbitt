---
import { getThoughts, getAnswers } from '../utils/finders';

import Application from '../layouts/Application.astro';
import Spacer from '../components/Spacer.astro';
import TrackView from '../components/TrackView.astro';
import PostCards from '../components/PostCards.astro';
import Directory from '../components/Directory.astro';

const thoughts = await getThoughts(3);
const answers = await getAnswers(3);

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Josh Nesbitt',
	url: 'https://joshnesbitt.dev',
	jobTitle: 'Chief Technology Officer',
	worksFor: {
		'@type': 'Organization',
		name: 'Stac Works',
		url: 'https://stac.works',
	},
	image: 'https://joshnesbitt.dev/headshot.jpg',
	sameAs: [
		'https://www.linkedin.com/in/josh-nesbitt',
		'https://github.com/joshnesbitt',
		'https://bsky.app/profile/joshnesbitt.dev',
	],
};

const focus = [
	{ name: 'Consultancy', href: 'https://stac.works' },
	{ name: 'Conference', href: 'https://heypresents.com/conference' },
	{ name: 'Podcast', href: 'https://heypresents.com/podcast' },
	{ name: 'Cooking', href: 'https://joshnesbitt.cooking' }
];
---

<Application title="Hello">
	<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

	<h1 class="sr-only">Josh Nesbitt</h1>

	<div class="markdown-container c-lede">
		<p>I'm Josh, a <a href="https://www.linkedin.com/in/josh-nesbitt">CTO</a> based in Leeds with over a decade leading engineering in product-led businesses. I also founded <a href="https://heypresents.com/conference">All Day Hey!</a>, one of the UK's longest-running independent technology conferences, and host <a href="https://heypresents.com/podcast">Off Script</a>, a podcast on engineering leadership and AI.</p>
	</div>

	<Spacer />

	<h2 class="c-sub-heading">Focus</h2>

	<Directory items={focus} />

	<Spacer />

	<h2 class="c-sub-heading">Thoughts</h2>

	<div class="-mt-6">
		<PostCards posts={thoughts} path="thoughts" />
	</div>

	{answers.length > 0 && (
		<Fragment>
			<Spacer />

			<h2 class="c-sub-heading">Ask me anything</h2>

			<Directory items={answers.map((answer) => ({
				name: answer.data.question,
				href: `/ama/${answer.id}`,
				meta: answer.data.pubDate.toLocaleDateString('en-uk', { year: 'numeric', month: 'short' }),
			}))} />

			<a class="c-callout mt-8" href="/ama">
				<span class="c-callout__eyebrow"><span class="c-callout__dot"></span>Your turn</span>
				<span class="c-callout__title">Got a question on leadership, AI or running events? Ask it.</span>
				<span class="c-callout__meta">The good ones get answered here, in public<span class="c-directory__arrow">&rarr;</span></span>
			</a>
		</Fragment>
	)}
</Application>

<TrackView key="home" />
