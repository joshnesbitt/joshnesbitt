---
// Items run oldest first. Consecutive items in the same year share one year
// label, and the last item is marked as where things are now.
const { items } = Astro.props;
---

<ol class="c-timeline">
	{items.map((item, index) => (
		<li class:list={['c-timeline__item', { 'is-continued': items[index - 1]?.year === item.year, 'is-current': index === items.length - 1 }]}>
			<span class="c-timeline__year">{item.year}</span>

			<div class="c-timeline__body">
				<h3 class="c-timeline__title">
					{item.href ? <a href={item.href}>{item.name}</a> : item.name}
				</h3>

				{item.text && <p class="c-timeline__text">{item.text}</p>}
			</div>
		</li>
	))}
</ol>
