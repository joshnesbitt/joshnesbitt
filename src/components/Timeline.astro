---
// Drawn as a single Tube line, oldest first. Items marked `major` are
// interchange stations with large titles; the rest are minor stations shown
// as ticks. Consecutive items in the same year share one year label, and the
// last station is where things are now.
const { items } = Astro.props;
---

<ol class="c-timeline">
	{items.map((item, index) => (
		<li class:list={['c-timeline__item', item.major ? 'is-major' : 'is-minor', { 'is-continued': items[index - 1]?.year === item.year, 'is-current': index === items.length - 1 }]}>
			<span class="c-timeline__year">{item.year}</span>

			<span class="c-timeline__track" aria-hidden="true">
				<span class="c-timeline__station"></span>
			</span>

			<div class="c-timeline__body">
				<h3 class="c-timeline__title">
					{item.href ? <a href={item.href}>{item.name}</a> : item.name}
				</h3>

				{item.text && <p class="c-timeline__text">{item.text}</p>}
			</div>
		</li>
	))}
</ol>
