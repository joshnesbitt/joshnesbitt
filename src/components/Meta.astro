---
import { ClientRouter } from 'astro:transitions';

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { ogImagePath } from '../utils/og';

export interface Props {
	title: string;
	description?: string;
	type?: 'website' | 'article';
	pubDate?: Date;
	// For pages that aren't a real address, like the 404: no canonical URL,
	// and the home page's share card.
	noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, type = 'website', pubDate, noindex = false } = Astro.props;
const fullTitle = `${title} · ${SITE_TITLE}`;

const pageURL = new URL(noindex ? '/' : Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImagePath(pageURL.pathname), Astro.site);
---

<!-- Global Metadata -->
<ClientRouter />
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link href="/favicon.ico" rel="icon" type="image/x-icon" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageURL} />}

<!-- Fonts -->
<link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

<!-- Feeds -->
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('/rss.xml', Astro.site)} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={pageURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{type === 'article' && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{type === 'article' && <meta property="article:author" content={SITE_TITLE} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={pageURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
