---
interface Props {
	items: { path: string; alt: string }[];
}

const { items } = Astro.props;

const variants: Record<number, string> = { 1: '', 3: 'c-gallery--three' };
const variant = variants[items.length] ?? 'c-gallery--two';
---

<div class={`not-markdown c-gallery ${variant}`}>
	{
		items.map((item) => (
			<div>
				<img src={item.path} alt={item.alt} loading="lazy" />
			</div>
		))
	}
</div>
