---
import { Image } from 'astro:assets';

import headshot from '../assets/images/headshot.jpg';

interface Props {
	bios: { label: string; text: string }[];
}

const { bios } = Astro.props;
---

<div class="c-presskit">
	{bios.map((bio) => (
		<div class="c-presskit__item">
			<div class="c-presskit__meta">
				<h3 class="c-presskit__label">{bio.label}</h3>
				<span class="c-presskit__separator" aria-hidden="true">
					/
				</span>
				<button class="c-presskit__action" type="button" data-copy={bio.text} aria-live="polite">
					Copy
				</button>
			</div>

			<p class="c-presskit__text">{bio.text}</p>
		</div>
	))}

	<div class="c-presskit__item">
		<div class="c-presskit__meta">
			<h3 class="c-presskit__label">Headshot</h3>
			<span class="c-presskit__separator" aria-hidden="true">
				/
			</span>
			<a class="c-presskit__action" href="/headshot.jpg" download="josh-nesbitt-headshot.jpg">
				Download
			</a>
		</div>

		<Image class="c-presskit__image" src={headshot} alt="Headshot of Josh Nesbitt" width={192} densities={[1, 2]} />
	</div>
</div>

<script>
	document.addEventListener('click', async (event) => {
		const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy]');

		if (!button) return;

		try {
			await navigator.clipboard.writeText(button.dataset.copy ?? '');

			button.textContent = 'Copied';
		} catch {
			// Clipboard access can be refused, so select the bio for a manual copy.
			const text = button.closest('.c-presskit__item')?.querySelector('.c-presskit__text');

			if (text) getSelection()?.selectAllChildren(text);
			button.textContent = 'Selected';
		}

		button.classList.add('is-copied');

		setTimeout(() => {
			button.textContent = 'Copy';
			button.classList.remove('is-copied');
		}, 2000);
	});
</script>
