---
const year = new Date().getFullYear();

const links = [
	{ label: 'GitHub', href: 'https://github.com/joshnesbitt' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/josh-nesbitt' },
	{ label: 'Bluesky', href: 'https://bsky.app/profile/joshnesbitt.dev' },
];
---

<footer class="c-footer">
	<ul class="c-footer__links">
		{links.map(({ label, href }) => (
			<li><a href={href}>{label}<span class="c-footer__arrow" aria-hidden="true">&nearr;</span></a></li>
		))}
	</ul>

	<p class="c-footer__copyright">&copy; {year} Josh Nesbitt &middot; <a href="/colophon">Colophon</a></p>
</footer>
