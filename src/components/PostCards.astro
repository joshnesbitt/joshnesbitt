---
import type { CollectionEntry } from 'astro:content';

interface Props {
	posts: CollectionEntry<'thought' | 'review'>[];
	// URL prefix for each post, e.g. 'thoughts'.
	path: string;
	level?: 2 | 3;
}

const { posts, path, level = 3 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<div>
	{posts.map((post) => (
		<div class="c-post-card">
			<Heading>
				<a href={`/${path}/${post.id}`}>{post.data.title}</a>
			</Heading>

			<p>{post.data.description}</p>
		</div>
	))}
</div>
