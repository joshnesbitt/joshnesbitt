---
interface Props {
	items: {
		name: string;
		href: string;
		// Shown on the right instead of the link's hostname.
		meta?: string;
	}[];
}

const { items } = Astro.props;

function destination(href: string) {
	if (!href.startsWith('http')) return href;

	return new URL(href).hostname.replace(/^www\./, '');
}

function isExternal(href: string) {
	return href.startsWith('http');
}
---

<ul class="c-directory">
	{items.map((item) => (
		<li>
			<a href={item.href}>
				<span class="c-directory__name">{item.name}</span>
				<span class="c-directory__destination">
					{item.meta ?? destination(item.href)}
					{isExternal(item.href) && <span class="c-directory__arrow">&nearr;</span>}
				</span>
			</a>
		</li>
	))}
</ul>
