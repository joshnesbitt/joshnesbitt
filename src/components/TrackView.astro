---
interface Props {
	key: string;
	namespace?: 'site' | 'thoughts' | 'reviews';
}

const { key, namespace = 'site' } = Astro.props;
---

<script is:inline data-astro-rerun data-view-id={`${namespace}:${key}`}>
	(() => {
		const id = document.currentScript.dataset.viewId;

		// Counting is best effort, so a failed request is ignored.
		fetch(`/api/views/${id}`, { method: 'POST', keepalive: true }).catch(() => {});
	})();
</script>
