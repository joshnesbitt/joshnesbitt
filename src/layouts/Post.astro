---
import { render } from 'astro:content';
import getReadingTime from 'reading-time';
import Application from './Application.astro';
import PageHeading from '../components/PageHeading.astro';
import Prose from '../components/Prose.astro';
import JsonLd from '../components/JsonLd.astro';
import { AUTHOR } from '../consts';
import { formatMonth } from '../utils/format';

const item = Astro.props
const { Content } = await render(item);
const readingTime = getReadingTime(item.body);
const data = Astro.props.data;
const date = data.pubDate;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`/api/og${Astro.url.pathname.replace(/\/$/, '')}.png`, Astro.site);

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: data.title,
	description: data.description,
	datePublished: date.toISOString(),
	url: canonicalURL.toString(),
	image: ogImageURL.toString(),
	author: {
		'@type': 'Person',
		...AUTHOR,
	},
};
---

<Application {...data} type="article" container="large">
	<JsonLd schema={schema} />
	<PageHeading>{data.title}</PageHeading>

	<Prose>
		<p class="text-lg font-bold">
			<time datetime={date.toISOString()} >
				{formatMonth(date)}
				&nbsp;
				·
				&nbsp;
				{readingTime.text}
			</time>
		</p>

		<Content />
	</Prose>
</Application>
