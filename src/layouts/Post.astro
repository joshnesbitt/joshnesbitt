---
import { render, type CollectionEntry } from 'astro:content';
import getReadingTime from 'reading-time';
import Application from './Application.astro';
import Spacer from '../components/Spacer.astro';
import { ogImagePath } from '../utils/og';
import { SITE_TITLE, SITE_URL } from '../consts';

type Props = CollectionEntry<'thought' | 'review'>;

const item = Astro.props;
const { Content } = await render(item);
const readingTime = getReadingTime(item.body ?? '');
const data = item.data;
const date = data.pubDate;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImagePath(Astro.url.pathname), Astro.site);

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: data.title,
	description: data.description,
	datePublished: date.toISOString(),
	url: canonicalURL.toString(),
	image: ogImageURL.toString(),
	author: {
		'@type': 'Person',
		name: SITE_TITLE,
		url: SITE_URL,
	},
};
---

<Application {...data} type="article">
	<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
	<h1 class="c-heading">{data.title}</h1>

	<Spacer />

	<div class="markdown-container">
		<p class="c-post-meta">
			<time datetime={date.toISOString()} >
				{date.toLocaleDateString('en-GB', {
			    year: 'numeric',
			    month: 'short'
			  })}
				&nbsp;
				·
				&nbsp;
				{readingTime.text}
			</time>
		</p>

		<Content />
	</div>
</Application>
