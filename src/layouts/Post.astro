---
import { render, type CollectionEntry } from 'astro:content';
import getReadingTime from 'reading-time';
import Application from './Application.astro';
import PageHeading from '../components/PageHeading.astro';
import Prose from '../components/Prose.astro';
import JsonLd from '../components/JsonLd.astro';
import { ogImagePath } from '../utils/og';
import { SITE_TITLE, SITE_URL } from '../consts';
import { formatMonth } from '../utils/format';

type Props = CollectionEntry<'thought' | 'review'>;

const item = Astro.props;
const { Content } = await render(item);
const readingTime = getReadingTime(item.body ?? '');
const data = item.data;
const date = data.pubDate;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImagePath(Astro.url.pathname), Astro.site);

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: data.title,
	description: data.description,
	datePublished: date.toISOString(),
	url: canonicalURL.toString(),
	image: ogImageURL.toString(),
	author: {
		'@type': 'Person',
		name: SITE_TITLE,
		url: SITE_URL,
	},
};
---

<Application {...data} type="article">
	<JsonLd schema={schema} />
	<PageHeading>{data.title}</PageHeading>

	<Prose>
		<p class="c-post-meta">
			<time datetime={date.toISOString()}>
				{formatMonth(date)}
				&nbsp; · &nbsp;
				{readingTime.text}
			</time>
		</p>

		<Content />
	</Prose>
</Application>
