---
import { render } from 'astro:content';
import getReadingTime from 'reading-time';
import Application from './Application.astro';
import Spacer from '../components/Spacer.astro';
import { getNextThought } from '../utils/finders';

const item = Astro.props
const { Content } = await render(item);
const readingTime = getReadingTime(item.body);
const data = Astro.props.data;
const date = data.pubDate;

const next = item.collection === 'thought' ? await getNextThought(item) : undefined;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`/api/og${Astro.url.pathname.replace(/\/$/, '')}.png`, Astro.site);

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: data.title,
	description: data.description,
	datePublished: date.toISOString(),
	url: canonicalURL.toString(),
	image: ogImageURL.toString(),
	author: {
		'@type': 'Person',
		name: 'Josh Nesbitt',
		url: 'https://joshnesbitt.dev',
	},
};
---

<Application {...data} type="article" container="large">
	<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
	<h1 class="c-heading">{data.title}</h1>

	<Spacer />

	<div class="markdown-container">
		<p class="text-lg font-bold">
			<time datetime={date.toISOString()} >
				{date.toLocaleDateString('en-uk', {
			    year: 'numeric',
			    month: 'short'
			  })}
				&nbsp;
				·
				&nbsp;
				{readingTime.text}
			</time>
		</p>

		<Content />
	</div>

	{next && (
		<aside class="c-read-next" aria-labelledby="read-next">
			<p class="c-read-next__label" id="read-next">Read next</p>
			<a class="c-read-next__link" href={`/thoughts/${next.id}`}>
				<span class="c-read-next__title">{next.data.title}<span class="c-read-next__arrow" aria-hidden="true">&rarr;</span></span>
				<span class="c-read-next__description">{next.data.description}</span>
			</a>
		</aside>
	)}
</Application>
